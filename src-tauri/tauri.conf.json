{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "shush",
  "version": "0.2.0",
  "identifier": "com.shush.vault",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../src/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "shush",
        "width": 1100,
        "height": 720,
        "minWidth": 720,
        "minHeight": 560,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#060609",
        "contentProtected": true
      },
      {
        "label": "spotlight",
        "create": false,
        "title": "shush quick search",
        "width": 640,
        "height": 440,
        "decorations": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#060609",
        "contentProtected": true,
        "shadow": true
      }
    ],
    "security": {
      "freezePrototype": true,
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "font-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "publisher": "Mahdi Ghozzi",
    "copyright": "Copyright (c) 2026 Mahdi Ghozzi. MIT License.",
    "category": "Utility",
    "shortDescription": "Local-first password vault for Windows",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "installerHooks": "windows/installer-hooks.nsh",
        "sidebarImage": "windows/installer-sidebar.bmp"
      }
    }
  }
}
