{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Main window: the full vault UI. App commands are denied unless listed (issue #20).",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "allow-app-info",
    "allow-vault-status",
    "allow-discard-vault-sibling",
    "allow-list-vaults",
    "allow-select-vault",
    "allow-check-new-vault",
    "allow-add-existing-vault",
    "allow-update-vault",
    "allow-forget-vault",
    "allow-set-hide-vault-names",
    "allow-delete-vault",
    "allow-show-in-explorer",
    "allow-inspect-keyfile",
    "allow-create-vault",
    "allow-unlock",
    "allow-reload-vault",
    "allow-lock",
    "allow-list-items",
    "allow-get-item",
    "allow-create-item",
    "allow-update-item",
    "allow-delete-item",
    "allow-purge-history",
    "allow-set-favorite",
    "allow-copy-field",
    "allow-reveal-password",
    "allow-totp-code",
    "allow-generate-password",
    "allow-export-backup",
    "allow-inspect-backup",
    "allow-preview-import",
    "allow-apply-import",
    "allow-preview-csv",
    "allow-import-csv",
    "allow-shred-csv",
    "allow-detect-browsers",
    "allow-list-folders",
    "allow-create-folder",
    "allow-rename-folder",
    "allow-delete-folder",
    "allow-show-spotlight",
    "allow-hide-spotlight",
    "allow-open-main-window",
    "allow-add-attachment",
    "allow-save-attachment",
    "allow-delete-attachment",
    "allow-duress-status",
    "allow-set-duress-password",
    "allow-vault-in-sync-folder",
    "allow-clear-duress-password",
    "allow-bridge-state",
    "allow-bridge-start-pairing",
    "allow-bridge-cancel-pairing",
    "allow-bridge-revoke",
    "allow-bridge-approve-save",
    "allow-bridge-reject-save",
    "allow-browser-support-status",
    "allow-set-browser-support",
    "allow-network-status",
    "allow-set-air-gapped",
    "allow-update-status",
    "allow-set-update-mode",
    "allow-check-for-update",
    "allow-download-update",
    "allow-install-update"
  ]
}
