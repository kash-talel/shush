{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "simple",
      "package-name": "shush",
      "include-component-in-tag": false,
      "draft": true,
      "force-tag-creation": true,
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        { "type": "toml", "path": "src-tauri/Cargo.toml", "jsonpath": "$.package.version" },
        { "type": "toml", "path": "src-tauri/Cargo.lock", "jsonpath": "$.package[?(@.name.value=='shush')].version" },
        { "type": "json", "path": "src/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "src/package-lock.json", "jsonpath": "$.version" },
        { "type": "json", "path": "src/package-lock.json", "jsonpath": "$.packages[''].version" },
        { "type": "json", "path": "src-tauri/tauri.conf.json", "jsonpath": "$.version" }
      ]
    }
  }
}
